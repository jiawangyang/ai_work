# OpenAI API Key for natural language to SQL conversion
OPENAI_API_KEY=sk-your-api-key-here

# Optional: Custom OpenAI API base URL (for proxy/relay providers)
# OPENAI_BASE_URL=https://your-proxy.example.com/v1

# Optional: Custom data directory (defaults to ~/.db_query)
DB_QUERY_DATA_DIR=~/.db_query

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# CORS origins (comma-separated, * for all)
CORS_ORIGINS=*
